{
  "name": "bb-plugin-browser",
  "version": "0.1.0",
  "description": "A host-local Workspace Browser for BB.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Browser",
    "description": "Open a host-local Workspace Browser from BB threads.",
    "branding": {
      "icon": "Globe"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:real-browser": "BB_BROWSER_REAL_INTEGRATION_REQUIRED=1 BB_BROWSER_REAL_INTEGRATION=1 vitest run test/browser-auth.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "release-gate": "bash scripts/release-gate.sh"
  },
  "dependencies": {
    "dev-browser": "0.2.9",
    "playwright": "1.58.2",
    "ws": "8.21.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@get-bb/plugin-sdk": "0.4.21",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "bb-app": "0.40.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "eslint": "^10.0.0",
    "hono": "^4.11.9",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vaul": "^1.1.2",
    "vitest": "^3.0.0"
  }
}
